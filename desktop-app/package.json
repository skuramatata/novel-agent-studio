{
  "name": "novel-agent-studio",
  "version": "0.1.86",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "node scripts/stamp-version.mjs",
    "prebuild": "node scripts/stamp-version.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "prepare:embedding": "node scripts/prepare-embedding.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "gpt-tokenizer": "4.0.0",
    "jsonrepair": "3.15.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
